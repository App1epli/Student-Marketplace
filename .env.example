# Local development. Keep this file at the repository root; copy it to .env.
POSTGRES_DB=student_marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
DATABASE_URL=postgresql://marketplace:marketplace@127.0.0.1:5432/student_marketplace
# Required Flask session secret. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value; set it in the hosting environment too.
SECRET_KEY=change-me-to-a-long-random-string
# Cloud (Neon): paste the pooled connection string with SSL into DATABASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional direct connection for the explicit --init-db command:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
